# Trial Path — Apache configuration for public_html.
# Applies to the static site, the API and the admin dashboard.

# ------------------------------------------------------------------ security

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    # Enable once HTTPS is confirmed working on the live domain (see DEPLOYMENT.md).
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The dashboard and the API must never be cached by a shared proxy.
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, private"
    </FilesMatch>
</IfModule>

# The bootstrap shim is included by other scripts, never requested directly.
<Files "_init.php">
    Require all denied
</Files>

# Dotfiles, backups and editor leftovers.
<FilesMatch "^\.|~$|\.(bak|sql|log|ini|sqlite|md)$">
    Require all denied
</FilesMatch>

# Nothing in this application needs directory listings.
Options -Indexes

# Do not advertise the PHP version.
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------- static site routing

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS. Comment out until the SSL certificate is issued.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Leave the API and the dashboard alone.
    RewriteRule ^(api|admin)/ - [L]

    # Next.js static export writes /about/index.html for /about. Serve those
    # without the trailing "index.html" showing up in the address bar.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ /$1/index.html [L]

    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ /$1.html [L]

    ErrorDocument 404 /404.html
</IfModule>

# ------------------------------------------------------------------- caching

<IfModule mod_expires.c>
    ExpiresActive On

    # Next.js fingerprints these filenames, so they can be cached hard.
    <FilesMatch "\.(js|css|woff2|woff|ttf)$">
        ExpiresDefault "access plus 1 year"
        <IfModule mod_headers.c>
            Header set Cache-Control "public, max-age=31536000, immutable"
        </IfModule>
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>

    # HTML changes on every deploy — revalidate.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        <IfModule mod_headers.c>
            Header set Cache-Control "public, max-age=0, must-revalidate"
        </IfModule>
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
        application/javascript application/json image/svg+xml
</IfModule>
